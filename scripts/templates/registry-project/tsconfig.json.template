{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "lib": ["ES2022", "DOM"],
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "exactOptionalPropertyTypes": true,
    "isolatedModules": true,
    "noEmit": true
  },
  "include": ["src/**/*", "registry/**/*", "scripts/**/*.mjs"]
}
