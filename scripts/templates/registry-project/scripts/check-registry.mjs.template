import { readFile } from "node:fs/promises";
import path from "node:path";

const rootDir = path.resolve(import.meta.dirname, "..");
const requiredJsonFiles = [
  "registry/config.json",
  "registry/default/items.json",
  "registry/templates/components.json",
  "apps/docs/public/components.json",
  "apps/docs/public/r/index.json",
  "apps/docs/public/r/example-card.json",
];

const readJson = async (relativePath) =>
  JSON.parse(await readFile(path.join(rootDir, relativePath), "utf-8"));

for (const relativePath of requiredJsonFiles) {
  await readJson(relativePath);
}

const items = await readJson("registry/default/items.json");
const publicItem = await readJson("apps/docs/public/r/example-card.json");

if (!Array.isArray(items) || items.length !== 1) {
  throw new Error("registry/default/items.json must contain one example item");
}

if (publicItem.name !== "example-card") {
  throw new Error("Generated example-card registry item is missing");
}

console.log("Checked generated registry project JSON");
